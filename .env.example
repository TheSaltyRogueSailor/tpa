# Required exact relying-party authority; never derive these from Host/X-Forwarded-Host.
TPA_ORIGIN=https://tpa.example.invalid
TPA_RP_ID=tpa.example.invalid

# Remains disabled unless the operator explicitly configures the exact value true.
TPA_AUTHORIZATION_ENABLED=false

# Placeholder only; supply real credentials solely through a host secret manager.
TPA_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Development permits an explicitly configured https://localhost authority only.
NODE_ENV=production

# Server mandate signing (Ed25519). Placeholders only: keep the real private key in
# the host secret manager, never in a committed file. Generate with
#   node scripts/generate-mandate-signing-key.mjs <keyId> /secure/path/key.b64
# Without these, checkout mandates are refused (fail closed).
TPA_MANDATE_SIGNING_KEY_ID=tpa-example-key-id
TPA_MANDATE_SIGNING_KEY=REPLACE_WITH_BASE64_PKCS8_ED25519_PRIVATE_KEY_FROM_SECRET_MANAGER
# Optional retired public keys still accepted for verification during rotation:
# TPA_MANDATE_VERIFY_KEYS=old-key-id=BASE64_SPKI_DER_PUBLIC_KEY
TPA_MANDATE_VERIFY_KEYS=

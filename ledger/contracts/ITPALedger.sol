pragma solidity ^0.8.20;

/// @title ITPALedger
/// @notice Adapter-facing interface for a verifier-server attestation registry.
/// @dev This is not a passkey, asset, payment, or settlement interface.
interface ITPALedger {
    enum Status {
        None,
        Active,
        Consumed,
        Revoked,
        Expired
    }

    /// @notice Records a backend verifier's attestation under an issuer/hash namespace.
    /// @param issuer Namespace owner, normally the account selected by the verifier workflow.
    /// @param mandateHash Opaque, nonzero identifier generated by the verifier workflow.
    /// @param expiresAt Absolute Unix timestamp; must be more than now and at most 300 seconds ahead.
    function recordMandate(address issuer, bytes32 mandateHash, uint64 expiresAt) external;

    /// @notice Atomically marks an active, unexpired attestation as consumed.
    function consume(address issuer, bytes32 mandateHash) external;

    /// @notice Revokes an attestation. The issuer or an authorized recorder may call this.
    function revoke(address issuer, bytes32 mandateHash) external;

    /// @notice Returns whether a mandate is active and strictly before its expiry time.
    function isValid(address issuer, bytes32 mandateHash) external view returns (bool);

    /// @notice Returns stored and time-aware statuses, plus expiry, for an issuer/hash namespace.
    function getMandate(address issuer, bytes32 mandateHash)
        external
        view
        returns (Status storedStatus, Status effectiveStatus, uint64 expiresAt);

    /// @notice Computes the canonical opaque key for off-chain indexing only.
    function mandateKey(address issuer, bytes32 mandateHash) external pure returns (bytes32);
}
